# Copia este archivo como .env y completa SOLO lo que vayas a usar.
# Nunca subas .env a Git ni compartas su contenido.

# Servidor
PUERTO_AM_ENV=development
PUERTO_AM_SESSION_SECRET=
PUERTO_AM_HORAS_SESION=8
PUERTO_AM_SECURE_COOKIES=0

# 1 = sólo landing pública con chat; desactiva /admin y toda llamada a n8n
PUERTO_AM_SOLO_LANDING=1

# Datos locales (por defecto, la base DEMO incluida en data/)
PUERTO_AM_EXCEL=
PUERTO_AM_DATOS=

# Supabase · memoria del chat. Usa la service_role key SOLO en el servidor.
# Crea las tablas con supabase/schema.sql en el SQL Editor del dashboard.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TIMEOUT=8
SUPABASE_HISTORIAL=12

# Datos públicos confirmados del restaurante (déjalos vacíos si no están verificados)
PUERTO_AM_WHATSAPP=
PUERTO_AM_EMAIL=
PUERTO_AM_DIRECCION=
PUERTO_AM_HORARIO=

# n8n: URL completa del webhook de cada workflow
N8N_PUBLIC_CHAT_URL=
N8N_FINANZAS_URL=
N8N_FACTURAS_URL=
N8N_BANCOS_URL=
N8N_PAGOS_URL=
N8N_PROVEEDORES_URL=
N8N_CAJA_URL=
N8N_NATIONAL_SOFT_URL=
N8N_REPORTES_URL=
N8N_CONTACTO_URL=
N8N_WEBHOOK_SECRET=
N8N_TIMEOUT=8

# Modelo de lenguaje opcional para redacción del asistente público.
# Puedes poner varios modelos separados por coma: se prueba el primero y se rota
# si hay error 429/5xx. Verificados el 2026-11-22:
# openrouter/free,liquid/lfm-3-1.7b:free,particle-ai/particle-1:free,inclusionai/ling-3.2-flash:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Correo autorizado para el envío de reportes vía n8n + Gmail
PUERTO_AM_GMAIL_DESTINO=
